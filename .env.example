# Google Maps Places API key (required for Google Maps collection)
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "Places API" in your GCP project
GMAPS_API_KEY=

# Optional: SerpAPI key for reliable Google search results
# Free tier: 100 searches/month — https://serpapi.com
SERPAPI_KEY=

# Database path (default: ./data/leads.db)
DATABASE_PATH=./data/leads.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate limiting (seconds between requests)
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0
