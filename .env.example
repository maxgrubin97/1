# Google Maps Places API key (required for Google Maps scraping)
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "Places API" and "Places API (New)" in your GCP project
GMAPS_API_KEY=

# Optional: SerpAPI key for more reliable Google search results
# Get one at: https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=
